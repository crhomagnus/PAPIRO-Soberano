{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certificado",
  "type": "object",
  "required": [
    "emissor",
    "participante",
    "evento",
    "periodo",
    "carga_horaria",
    "assinaturas"
  ],
  "properties": {
    "emissor": {
      "type": "object",
      "required": [
        "nome"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "participante": {
      "type": "string",
      "minLength": 1
    },
    "evento": {
      "type": "string",
      "minLength": 1
    },
    "periodo": {
      "type": "string",
      "minLength": 1
    },
    "carga_horaria": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "tipo": {
      "type": "string",
      "minLength": 1
    },
    "verbo": {
      "type": "string",
      "minLength": 1
    },
    "local": {
      "type": "string",
      "minLength": 1
    },
    "assinaturas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "nome",
          "cargo"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "cargo": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "codigo_verificacao": {
      "type": "string",
      "minLength": 1
    },
    "url_verificacao": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "url_verificacao"
        ]
      },
      "then": {
        "required": [
          "codigo_verificacao"
        ]
      }
    }
  ]
}
