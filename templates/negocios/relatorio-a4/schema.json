{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relatório",
  "type": "object",
  "required": [
    "titulo",
    "autor",
    "secoes"
  ],
  "properties": {
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "subtitulo": {
      "type": "string",
      "minLength": 1
    },
    "autor": {
      "type": "string",
      "minLength": 1
    },
    "organizacao": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{2}/\\d{2}/\\d{4}$"
    },
    "resumo": {
      "type": "string",
      "minLength": 1
    },
    "logo": {
      "type": "string",
      "minLength": 1
    },
    "secoes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "titulo"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "paragrafos": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "topicos": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "subsecoes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "titulo"
              ],
              "properties": {
                "titulo": {
                  "type": "string",
                  "minLength": 1
                },
                "paragrafos": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
