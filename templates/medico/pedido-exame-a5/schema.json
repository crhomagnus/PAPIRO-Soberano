{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pedido de exame",
  "type": "object",
  "required": [
    "medico",
    "paciente",
    "exames"
  ],
  "properties": {
    "medico": {
      "type": "object",
      "required": [
        "nome",
        "crm",
        "uf"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "crm": {
          "type": "string",
          "pattern": "^[0-9]{1,8}$"
        },
        "uf": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "rqe": {
          "type": "string",
          "minLength": 1
        },
        "especialidade": {
          "type": "string",
          "minLength": 1
        },
        "endereco": {
          "type": "string",
          "minLength": 1
        },
        "telefone": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paciente": {
      "type": "object",
      "required": [
        "nome"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "data_nascimento": {
          "type": "string",
          "pattern": "^\\d{2}/\\d{2}/\\d{4}$"
        },
        "documento": {
          "type": "object",
          "required": [
            "tipo",
            "numero"
          ],
          "properties": {
            "tipo": {
              "type": "string",
              "minLength": 1
            },
            "numero": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "convenio": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "nome"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "codigo": {
            "type": "string",
            "minLength": 1
          },
          "observacao": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "indicacao_clinica": {
      "type": "string",
      "minLength": 1
    },
    "cid": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{2}(\\.[0-9A-Z]{1,2})?$"
    },
    "local": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{2}/\\d{2}/\\d{4}$"
    }
  }
}
