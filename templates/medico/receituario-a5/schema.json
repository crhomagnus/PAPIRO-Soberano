{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receituário",
  "type": "object",
  "required": [
    "medico",
    "paciente",
    "itens"
  ],
  "properties": {
    "medico": {
      "type": "object",
      "required": [
        "nome",
        "crm",
        "uf"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "crm": {
          "type": "string",
          "pattern": "^[0-9]{1,8}$"
        },
        "uf": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "rqe": {
          "type": "string",
          "minLength": 1
        },
        "especialidade": {
          "type": "string",
          "minLength": 1
        },
        "endereco": {
          "type": "string",
          "minLength": 1
        },
        "telefone": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paciente": {
      "type": "object",
      "required": [
        "nome"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "endereco": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tipo": {
      "enum": [
        "simples",
        "controle_especial"
      ]
    },
    "itens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "medicamento",
          "posologia"
        ],
        "properties": {
          "medicamento": {
            "type": "string",
            "minLength": 1
          },
          "posologia": {
            "type": "string",
            "minLength": 1
          },
          "quantidade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "unidade": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "orientacoes": {
      "type": "string",
      "minLength": 1
    },
    "local": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{2}/\\d{2}/\\d{4}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "controle_especial"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "properties": {
          "paciente": {
            "required": [
              "nome",
              "endereco"
            ]
          },
          "itens": {
            "items": {
              "required": [
                "medicamento",
                "posologia",
                "quantidade",
                "unidade"
              ]
            }
          }
        }
      }
    }
  ]
}
