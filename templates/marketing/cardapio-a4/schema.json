{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cardápio",
  "type": "object",
  "required": [
    "estabelecimento",
    "secoes"
  ],
  "properties": {
    "estabelecimento": {
      "type": "string",
      "minLength": 1
    },
    "subtitulo": {
      "type": "string",
      "minLength": 1
    },
    "logo": {
      "type": "string",
      "minLength": 1
    },
    "observacoes": {
      "type": "string",
      "minLength": 1
    },
    "secoes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "nome",
          "itens"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "itens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "nome",
                "preco"
              ],
              "properties": {
                "nome": {
                  "type": "string",
                  "minLength": 1
                },
                "preco": {
                  "type": "number",
                  "minimum": 0
                },
                "descricao": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
