{
  "$schema": "https://opencode.ai/config.json",
  "username": "papiro",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "default_agent": "papiro-soberano",
  "instructions": [
    "AGENTS.md",
    "docs/AGENTE_AUTONOMO_ENGENHARIA_PDF.md",
    "docs/PAPIRO_PRD_ORIGINAL.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "C:/PAPIRO/**": "allow",
      "C:/Users/mecca/Downloads/**": "allow",
      "*": "ask"
    }
  },
  "mcp": {
    "papiro": {
      "type": "local",
      "command": [
        "python",
        "mcp-papiro.py"
      ],
      "enabled": true,
      "environment": {
        "PYTHONPATH": "core",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "PAPIRO_HOME": "C:/PAPIRO"
      }
    },
    "papiro-seguranca": {
      "type": "local",
      "command": [
        "python",
        "mcp-papiro-seguranca.py"
      ],
      "enabled": true,
      "environment": {
        "PYTHONPATH": "core",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "PAPIRO_HOME": "C:/PAPIRO"
      }
    }
  },
  "plugin": [],
  "formatter": false,
  "lsp": false,
  "tools": {
    "papiro-seguranca*": false
  }
}
